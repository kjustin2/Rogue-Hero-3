{
  "name": "rogue-hero-3",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "npm run standalone",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "electron .",
    "standalone": "npm run build && electron .",
    "verify": "npm run build",
    "test": "node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "qa": "node scripts/smoke.mjs",
    "qa:fast": "node scripts/smoke.mjs",
    "qa:loop": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --win portable",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "author": "Justin Kramer",
  "build": {
    "appId": "com.roguehero.emberrift",
    "productName": "Rogue Hero 3",
    "files": [
      "electron-main.cjs",
      "electron-ipc.cjs",
      "preload.cjs",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Rogue-Hero-3-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Rogue Hero 3"
    }
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/rajdhani": "^5.2.7",
    "postprocessing": "^6.36.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
